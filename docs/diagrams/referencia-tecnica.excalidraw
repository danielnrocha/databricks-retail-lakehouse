    {
      "id": "e0876026",
      "type": "text",
      "x": 72.18,
      "y": 1897.39,
      "width": 484,
      "height": 112.5,
      "angle": 0.0019,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 33393776,
      "version": 207,
      "versionNonce": 535186398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786142132087,
      "link": null,
      "locked": false,
      "text": "O portão REPROVOU o modelo\n\nPR-AUC 0,1420 contra baseline de recência 0,3846 → −63,1%\nfrente\naos +10% exigidos. Não registrado, sem alias champion. MLR-004\nimpede a promoção.",
      "originalText": "O portão REPROVOU o modelo\n\nPR-AUC 0,1420 contra baseline de recência 0,3846 → −63,1% frente\naos +10% exigidos. Não registrado, sem alias champion. MLR-004\nimpede a promoção.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0879956",
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b0T"
    },
    {
      "id": "e0895358",
      "type": "rectangle",
      "x": 618.63,
      "y": 1739.88,
      "width": 500,
      "height": 241,
      "angle": 0.0076,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
