    },
    {
      "id": "e0677991",
      "type": "text",
      "x": 71.86,
      "y": 1302.92,
      "width": 484,
      "height": 131.25,
      "angle": 0.002,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1434192872,
      "version": 255,
      "versionNonce": 1388210590,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786142636754,
      "link": null,
      "locked": false,
      "text": "O skew existe, e é enorme\n\nmax/median por chave:\nSTORE_ID 2.519×\nPRODUCT_ID 9.926×\nO teste exige >1.000× e >5.000× para que a premissa do lab falhe\nse o dado mudar.",
      "originalText": "O skew existe, e é enorme\n\nmax/median por chave:\nSTORE_ID 2.519×\nPRODUCT_ID 9.926×\nO teste exige >1.000× e >5.000× para que a premissa do lab falhe\nse o dado mudar.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0675085",
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b0A"
    },
    {
      "id": "e0693992",
      "type": "rectangle",
      "x": 70.63,
      "y": 1468.29,
      "width": 500,
      "height": 160,
      "angle": 0.0016,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 627068659,
      "version": 32,
      "versionNonce": 1549506590,
      "isDeleted": false,
      "boundElements": [
