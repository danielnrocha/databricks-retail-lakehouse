    {
      "id": "e0916864",
      "type": "text",
      "x": 1179.59,
      "y": 1742.79,
      "width": 484,
      "height": 131.25,
      "angle": 0.0001,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
