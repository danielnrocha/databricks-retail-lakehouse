      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "O profiler do DQX é bom demais para confiar\n\nAs regras auto-geradas teriam quarentenado 23,6% da receita —\ncodificam como lei a anomalia presente no momento do profiling.\nQLT-005: profiling propõe, humano dispõe.",
      "originalText": "O profiler do DQX é bom demais para confiar\n\nAs regras auto-geradas teriam quarentenado 23,6% da receita —\ncodificam como lei a anomalia presente no momento do profiling.\nQLT-005: profiling propõe, humano dispõe.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0549450",
      "lineHeight": 1.25,
      "autoResize": false
    },
