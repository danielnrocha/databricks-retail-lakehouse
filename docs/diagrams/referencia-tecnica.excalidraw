    },
    {
      "id": "e0777843",
      "type": "text",
      "x": 1174.83,
      "y": 1472.985,
      "width": 484,
      "height": 131.25,
      "angle": -0.0067,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1052636723,
      "version": 385,
      "versionNonce": 1940376514,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786142643287,
      "link": null,
      "locked": false,
      "text": "A evidência vem de onde dá\n\nsystem.query.history + Query Profile. shuffle_read_bytes existe\ne é sempre 0; spilled_local_bytes popula. Daí a largura de\nUnsafeRow ser estimada — e um teste falha no dia em que a\ncoluna\npassar a valer, para trocar estimativa por medição.",
      "originalText": "A evidência vem de onde dá\n\nsystem.query.history + Query Profile. shuffle_read_bytes existe\ne é sempre 0; spilled_local_bytes popula. Daí a largura de\nUnsafeRow ser estimada — e um teste falha no dia em que a coluna\npassar a valer, para trocar estimativa por medição.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0778893",
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b0K"
    },
    {
      "id": "e0792637",
      "type": "rectangle",
      "x": 1718.547105773936,
      "y": 1295.778416625889,
      "width": 500,
      "height": 166,
      "angle": 0.0003,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1293525805,
      "version": 312,
      "versionNonce": 1118493378,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
