      "roundness": null,
      "seed": 1798342879,
      "version": 171,
      "versionNonce": 1841327614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Agente: tools são UC Functions\n\n3 funções registradas em Unity Catalog como ferramentas. O\ngrounding não é instrução de prompt: se o número não veio de uma\ntool contra objeto governado, ele não existe (AGT-001). Endpoint\ndatabricks-gpt-oss-120b — tool calling funciona; 11 endpoints\ndisponíveis.",
      "originalText": "Agente: tools são UC Functions\n\n3 funções registradas em Unity Catalog como ferramentas. O\ngrounding não é instrução de prompt: se o número não veio de uma\ntool contra objeto governado, ele não existe (AGT-001). Endpoint\ndatabricks-gpt-oss-120b — tool calling funciona; 11 endpoints\ndisponíveis.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0914955",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0934267",
