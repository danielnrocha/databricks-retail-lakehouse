    },
    {
      "id": "e0937464",
      "type": "text",
      "x": 1176.61,
      "y": 1915.0,
      "width": 484,
      "height": 112.5,
      "angle": 0.007,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
