    {
      "id": "e0876026",
      "type": "text",
      "x": 75.18,
      "y": 1900.14,
      "width": 484,
      "height": 93.75,
      "angle": 0.0019,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 33393776,
      "version": 204,
      "versionNonce": 580568952,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "O portão REPROVOU o modelo\n\nPR-AUC 0,1420 contra baseline de recência 0,3846 → −63,1% frente\naos +10% exigidos. Não registrado, sem alias champion. MLR-004\nimpede a promoção.",
      "originalText": "O portão REPROVOU o modelo\n\nPR-AUC 0,1420 contra baseline de recência 0,3846 → −63,1% frente\naos +10% exigidos. Não registrado, sem alias champion. MLR-004\nimpede a promoção.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0879956",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0895358",
      "type": "rectangle",
      "x": 618.63,
      "y": 1739.88,
      "width": 500,
      "height": 241.0,
      "angle": 0.0076,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 58065936,
      "version": 85,
      "versionNonce": 712426142,
      "isDeleted": false,
      "boundElements": [
