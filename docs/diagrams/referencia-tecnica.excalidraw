      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Qualidade em duas camadas\n\nDQX + expectations governadas em UC. Linha reprovada vai para\nquarentena com rule_name, rule_expression e failed_at; QLT-003\nexige input = passed + quarantined, sem tolerância.",
      "originalText": "Qualidade em duas camadas\n\nDQX + expectations governadas em UC. Linha reprovada vai para\nquarentena com rule_name, rule_expression e failed_at; QLT-003\nexige input = passed + quarantined, sem tolerância.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0504834",
      "lineHeight": 1.25,
      "autoResize": false
    },
