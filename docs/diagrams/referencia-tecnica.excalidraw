      "locked": false
    },
    {
      "id": "e0404851",
      "type": "text",
      "x": 628.46,
      "y": 637.61,
      "width": 484,
      "height": 93.75,
      "angle": 0.0002,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
