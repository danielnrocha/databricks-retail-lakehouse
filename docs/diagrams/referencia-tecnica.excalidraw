      "link": null,
      "locked": false
    },
    {
      "id": "e0794389",
      "type": "text",
      "x": 1726.54,
      "y": 1303.84,
      "width": 484,
      "height": 150.0,
      "angle": 0.0003,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1870165549,
      "version": 354,
      "versionNonce": 619735712,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "O instrumento quase inventou 84 resultados\n\nO lab invalidava o cache variando um COMENTÁRIO na query. O\nDatabricks tira comentário da chave de cache — as 84 execuções\nteriam sido internamente consistentes e completamente sem\nsentido. Só apareceu porque read_bytes voltava 0. Hoje: literal\nvariável na projeção externa, e um teste rejeita run com\nfrom_result_cache.",
      "originalText": "O instrumento quase inventou 84 resultados\n\nO lab invalidava o cache variando um COMENTÁRIO na query. O\nDatabricks tira comentário da chave de cache — as 84 execuções\nteriam sido internamente consistentes e completamente sem\nsentido. Só apareceu porque read_bytes voltava 0. Hoje: literal\nvariável na projeção externa, e um teste rejeita run com\nfrom_result_cache.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0792637",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0815840",
      "type": "rectangle",
      "x": 1722.04,
      "y": 1488.74,
      "width": 500,
      "height": 128.5,
      "angle": -0.0039,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 336097690,
      "version": 307,
      "versionNonce": 515938975,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "e0819169"
        }
