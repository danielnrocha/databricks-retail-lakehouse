      "locked": false
    },
    {
      "id": "e0718890",
      "type": "text",
      "x": 626.7,
      "y": 1298.14,
      "width": 484,
      "height": 131.25,
      "angle": -0.0067,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1733626199,
      "version": 155,
      "versionNonce": 879466077,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Resultado negativo mantido\n\nA chave de join real é composta: (PRODUCT_ID, STORE_ID,\nWEEK_NO). Em 1024 partições ela dá max/median < 1,5 e não\ndispara a condição de fator. Ou seja: salting seria\ninjustificado neste dataset. O teste existe para impedir alguém\nde reintroduzir salt 'porque tem skew'.",
      "originalText": "Resultado negativo mantido\n\nA chave de join real é composta: (PRODUCT_ID, STORE_ID,\nWEEK_NO). Em 1024 partições ela dá max/median < 1,5 e não\ndispara a condição de fator. Ou seja: salting seria\ninjustificado neste dataset. O teste existe para impedir alguém\nde reintroduzir salt 'porque tem skew'.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0716998",
      "lineHeight": 1.25,
      "autoResize": false
    },
