    },
    {
      "id": "e0971704",
      "type": "text",
      "x": 1725.34,
      "y": 1880.02,
      "width": 484,
      "height": 168.75,
      "angle": 0.0032,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1907692965,
      "version": 342,
      "versionNonce": 1651072191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "A primeira rodada deu 33% no caso FÁCIL\n\nAs expectativas estavam escritas como listas exaustivas, então\nfato correto A MAIS virava não-conformidade — e o juiz zerou\ngroundedness por uma reclamação de verbosidade. Baixar o limiar\nde 90% para 80% seria tuning. Reescrever 'reporte X e Y' como\n'DEVE INCLUIR X e Y; fatos extras da mesma tool são bem-vindos'\ncorrige um enunciado que dizia outra coisa. Os limiares não\nforam tocados.",
      "originalText": "A primeira rodada deu 33% no caso FÁCIL\n\nAs expectativas estavam escritas como listas exaustivas, então\nfato correto A MAIS virava não-conformidade — e o juiz zerou\ngroundedness por uma reclamação de verbosidade. Baixar o limiar\nde 90% para 80% seria tuning. Reescrever 'reporte X e Y' como\n'DEVE INCLUIR X e Y; fatos extras da mesma tool são bem-vindos'\ncorrige um enunciado que dizia outra coisa. Os limiares não\nforam tocados.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0973830",
      "lineHeight": 1.25,
      "autoResize": false
    },
