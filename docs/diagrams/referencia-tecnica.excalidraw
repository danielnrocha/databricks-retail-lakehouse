    },
    {
      "id": "e0691749",
      "type": "text",
      "x": 75.63,
      "y": 1473.29,
      "width": 484,
      "height": 150,
      "angle": 0.0016,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 424111499,
      "version": 225,
      "versionNonce": 1824798786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786142635252,
      "link": null,
      "locked": false,
      "text": "…e a AQE não encosta nele\n\nO skew join da AQE exige AS DUAS condições: fator ≥5× E\npartição\n≥256 MB. STORE_ID passa o fator por três ordens de grandeza\ne a\npartição mais quente fica uma ordem ABAIXO do piso de bytes.\nResultado: AQE, corretamente, não faz nada.",
      "originalText": "…e a AQE não encosta nele\n\nO skew join da AQE exige AS DUAS condições: fator ≥5× E partição\n≥256 MB. STORE_ID passa o fator por três ordens de grandeza e a\npartição mais quente fica uma ordem ABAIXO do piso de bytes.\nResultado: AQE, corretamente, não faz nada.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0693992",
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b0C"
    },
    {
      "id": "e0716998",
      "type": "rectangle",
      "x": 618.7,
      "y": 1290.3535666658315,
      "width": 500,
      "height": 147.25,
      "angle": -0.0067,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1774849806,
      "version": 32,
      "versionNonce": 1390802626,
      "isDeleted": false,
      "boundElements": [
