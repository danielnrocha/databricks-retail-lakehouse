    {
      "id": "e0691749",
      "type": "text",
      "x": 78.63,
      "y": 1476.29,
      "width": 484,
      "height": 112.5,
      "angle": 0.0016,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
