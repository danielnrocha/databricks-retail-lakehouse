    },
    {
      "id": "e0677991",
      "type": "text",
      "x": 74.86,
      "y": 1302.92,
      "width": 484,
      "height": 131.25,
      "angle": 0.002,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
