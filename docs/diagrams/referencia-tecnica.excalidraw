    {
      "id": "e0665765",
      "type": "text",
      "x": 70,
      "y": 1243.08,
      "width": 1035,
      "height": 18.75,
      "angle": -0.0017,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 257544974,
      "version": 177,
      "versionNonce": 384414110,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786141800546,
      "link": null,
      "locked": false,
      "text": "Base: 2X-Small serverless + Photon · transactions 2.595.732 · causal 36.786.524 · 84 execuções registradas, cada uma com seu statement_id.",
      "originalText": "Base: 2X-Small serverless + Photon · transactions 2.595.732 · causal 36.786.524 · 84 execuções registradas, cada uma com seu statement_id.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b08"
    },
    {
      "id": "e0675085",
