    {
      "id": "e0426845",
      "type": "text",
      "x": 1177.34,
      "y": 484.44,
      "width": 484,
      "height": 168.75,
      "angle": -0.0066,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
