    {
      "id": "e0447971",
      "type": "text",
      "x": 1727.63,
      "y": 489.01,
      "width": 484,
      "height": 112.5,
      "angle": -0.0064,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
