      "updated": 1786142618117,
      "link": null,
      "locked": false,
      "text": "4 · LAB DE PERFORMANCE — skew, spill e o que não dá para medir aqui",
      "originalText": "4 · LAB DE PERFORMANCE — skew, spill e o que não dá para medir aqui",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
