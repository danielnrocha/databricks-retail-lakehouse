    },
    {
      "id": "e0754114",
      "type": "text",
      "x": 1175.35,
      "y": 1302.36,
      "width": 484,
      "height": 131.25,
      "angle": 0.0069,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1581529924,
      "version": 131,
      "versionNonce": 1437188316,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Sem Spark UI no serverless\n\nNenhuma métrica por task existe. Consequência afiada: o limiar\nde skew que a própria Databricks documenta — max task > 1,5× o\np75 — é IMENSURÁVEL na plataforma que o recomenda. Isso é\nlimitação de serverless, não de Free Edition: quem padroniza em\nserverless herda independentemente do que paga.",
      "originalText": "Sem Spark UI no serverless\n\nNenhuma métrica por task existe. Consequência afiada: o limiar\nde skew que a própria Databricks documenta — max task > 1,5× o\np75 — é IMENSURÁVEL na plataforma que o recomenda. Isso é\nlimitação de serverless, não de Free Edition: quem padroniza em\nserverless herda independentemente do que paga.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0753209",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0778893",
      "type": "rectangle",
      "x": 1169.83,
      "y": 1467.61,
      "width": 500,
      "height": 128.5,
      "angle": -0.0067,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 657041702,
      "version": 41,
      "versionNonce": 1263094824,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "e0777843"
        }
      ],
      "updated": 1786160000000,
      "link": null,
      "locked": false
    },
    {
      "id": "e0777843",
      "type": "text",
      "x": 1177.83,
      "y": 1475.61,
      "width": 484,
      "height": 112.5,
      "angle": -0.0067,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1052636723,
      "version": 382,
      "versionNonce": 1982000601,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "A evidência vem de onde dá\n\nsystem.query.history + Query Profile. shuffle_read_bytes existe\ne é sempre 0; spilled_local_bytes popula. Daí a largura de\nUnsafeRow ser estimada — e um teste falha no dia em que a coluna\npassar a valer, para trocar estimativa por medição.",
      "originalText": "A evidência vem de onde dá\n\nsystem.query.history + Query Profile. shuffle_read_bytes existe\ne é sempre 0; spilled_local_bytes popula. Daí a largura de\nUnsafeRow ser estimada — e um teste falha no dia em que a coluna\npassar a valer, para trocar estimativa por medição.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0778893",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0792637",
      "type": "rectangle",
      "x": 1718.54,
      "y": 1295.84,
      "width": 500,
      "height": 166.0,
      "angle": 0.0003,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1293525805,
      "version": 309,
      "versionNonce": 936214284,
      "isDeleted": false,
      "boundElements": [
