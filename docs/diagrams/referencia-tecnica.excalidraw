    {
      "id": "e0754114",
      "type": "text",
      "x": 1172.354022568605,
      "y": 1302.2353003732428,
      "width": 484,
      "height": 131.25,
      "angle": 0.0069,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1581529924,
      "version": 135,
      "versionNonce": 847621250,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786142782833,
      "link": null,
      "locked": false,
      "text": "Sem Spark UI no serverless\n\nNenhuma métrica por task existe. Consequência afiada: o limiar\nde skew que a própria Databricks documenta — max task > 1,5× o\np75 — é IMENSURÁVEL na plataforma que o recomenda. Isso é\nlimitação de serverless, não de Free Edition: quem padroniza em\nserverless herda independentemente do que paga.",
      "originalText": "Sem Spark UI no serverless\n\nNenhuma métrica por task existe. Consequência afiada: o limiar\nde skew que a própria Databricks documenta — max task > 1,5× o\np75 — é IMENSURÁVEL na plataforma que o recomenda. Isso é\nlimitação de serverless, não de Free Edition: quem padroniza em\nserverless herda independentemente do que paga.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0753209",
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "b0I"
    },
    {
      "id": "e0778893",
      "type": "rectangle",
      "x": 1169.83,
      "y": 1467.61,
      "width": 500,
      "height": 142,
      "angle": -0.0067,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
