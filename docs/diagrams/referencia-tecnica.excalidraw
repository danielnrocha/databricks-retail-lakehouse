      "roundness": null,
      "seed": 1434192872,
      "version": 253,
      "versionNonce": 2134459642,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "O skew existe, e é enorme\n\nmax/median por chave:\nSTORE_ID 2.519×\nPRODUCT_ID 9.926×\nO teste exige >1.000× e >5.000× para que a premissa do lab falhe\nse o dado mudar.",
      "originalText": "O skew existe, e é enorme\n\nmax/median por chave:\nSTORE_ID 2.519×\nPRODUCT_ID 9.926×\nO teste exige >1.000× e >5.000× para que a premissa do lab falhe\nse o dado mudar.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0675085",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0693992",
