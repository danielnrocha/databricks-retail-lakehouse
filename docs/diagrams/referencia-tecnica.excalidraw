      "seed": 922994794,
      "version": 369,
      "versionNonce": 655719969,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Medido em 4 tranches de 100 arquivos\n\nT1 pré-drift: 1 versão de schema, 0 resgatadas.\nT2 coluna nova → 2 versões.\nT3 rename → 3 versões.\nT4 retype → 49.468 resgatadas, 200.000 linhas preservadas (400\narq. × 500).\nConferido contra a fonte em disco: 49.468 eventos com quantity\nstring. Bate exato.",
      "originalText": "Medido em 4 tranches de 100 arquivos\n\nT1 pré-drift: 1 versão de schema, 0 resgatadas.\nT2 coluna nova → 2 versões.\nT3 rename → 3 versões.\nT4 retype → 49.468 resgatadas, 200.000 linhas preservadas (400\narq. × 500).\nConferido contra a fonte em disco: 49.468 eventos com quantity\nstring. Bate exato.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0422884",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0448621",
