      "text": "spark.sql.adaptive.enabled\nspark.sql.adaptive.skewJoin.enabled\nspark.sql.shuffle.partitions\n→ CONFIG_NOT_AVAILABLE · SQLSTATE 42K0I",
      "originalText": "spark.sql.adaptive.enabled\nspark.sql.adaptive.skewJoin.enabled\nspark.sql.shuffle.partitions\n→ CONFIG_NOT_AVAILABLE · SQLSTATE 42K0I",
