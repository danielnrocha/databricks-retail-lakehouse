      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Como a compra de uma pessoa vira decisão de negócio — e o que aceitamos perder pelo caminho.",
      "originalText": "Como a compra de uma pessoa vira decisão de negócio — e o que aceitamos perder pelo caminho.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
