    {
      "id": "el016824",
      "type": "text",
      "x": 152.47332776290403,
      "y": 579.394758519534,
      "width": 384,
      "height": 120,
      "angle": 0.0064,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
