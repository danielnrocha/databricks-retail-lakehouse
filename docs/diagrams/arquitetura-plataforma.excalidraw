      "boundElements": [],
      "updated": 1786150000000,
      "link": null,
      "locked": false,
      "text": "▲ Só D3 e D4 justificam tempo real. Usar streaming onde lote resolve é desperdício de dinheiro; usar lote onde minutos importam é\nprejuízo de negócio. A fronteira é uma decisão, não um gosto.",
      "originalText": "▲ Só D3 e D4 justificam tempo real. Usar streaming onde lote resolve é desperdício de dinheiro; usar lote onde minutos importam é\nprejuízo de negócio. A fronteira é uma decisão, não um gosto.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
