      "type": "text",
      "x": 70,
      "y": 202,
      "width": 877.5,
      "height": 37.5,
      "angle": 0.0099,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
