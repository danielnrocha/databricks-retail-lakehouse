      "width": 384,
      "height": 120.0,
      "angle": 0.0064,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1975710023,
      "version": 90,
      "versionNonce": 994774939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786150000000,
      "link": null,
      "locked": false,
      "text": "Compras de verdade\n\nHistórico real e anonimizado de 2.500 famílias:\n2,6 milhões de itens de cupom fiscal, 582 lojas,\n2 anos. Traz comportamento de gente de verdade —\nque ninguém consegue inventar.",
      "originalText": "Compras de verdade\n\nHistórico real e anonimizado de 2.500 famílias:\n2,6 milhões de itens de cupom fiscal, 582 lojas,\n2 anos. Traz comportamento de gente de verdade —\nque ninguém consegue inventar.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "el016315",
      "lineHeight": 1.25,
      "autoResize": false
    },
