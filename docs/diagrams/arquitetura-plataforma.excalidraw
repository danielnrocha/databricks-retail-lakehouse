      "type": "text",
      "x": 70,
      "y": 2082.07,
      "width": 975.0,
      "height": 37.5,
      "angle": 0.0043,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
