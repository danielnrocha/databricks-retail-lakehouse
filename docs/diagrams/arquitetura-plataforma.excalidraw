      "seed": 2009271680,
      "version": 282,
      "versionNonce": 1689583753,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786160000000,
      "link": null,
      "locked": false,
      "text": "Compras de verdade\n\nHistórico real e anonimizado de 2.500 famílias: 2,6\nmilhões de itens de cupom fiscal, 582 lojas, 2\nanos. Traz comportamento de gente de verdade — que\nninguém consegue inventar.",
      "originalText": "Compras de verdade\n\nHistórico real e anonimizado de 2.500 famílias: 2,6\nmilhões de itens de cupom fiscal, 582 lojas, 2\nanos. Traz comportamento de gente de verdade — que\nninguém consegue inventar.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e0174322",
      "lineHeight": 1.25,
      "autoResize": false
    },
