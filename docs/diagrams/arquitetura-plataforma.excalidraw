      "boundElements": [],
      "updated": 1786138301570,
      "link": null,
      "locked": false,
      "text": "✔ Ouro fecha com prata: 198.013 linhas e R$ 613.396,36,\ndiferença zero. Conferido a cada execução, não uma vez só.",
      "originalText": "✔ Ouro fecha com prata: 198.013 linhas e R$ 613.396,36,\ndiferença zero. Conferido a cada execução, não uma vez só.",
